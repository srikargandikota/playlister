SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=your_spotify_redirect_uri

JWT_SECRET=super-secret-jwt-key

DATABASE_URL=postgres://music_tagger_user:music_tagger_password@localhost:5432/music_tagger


# Audio features for tonality classification (no key required)
RECCOBEATS_BASE_URL=https://api.reccobeats.com/v1
RECCOBEATS_BATCH_SIZE=40

# Optional: enables Claude for natural language commands ("something mellow in a minor key")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
